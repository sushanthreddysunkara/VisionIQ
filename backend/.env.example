# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Existing MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vision-iq
MYSQL_SSL=false

# Frontend and backend binding
FRONTEND_URL=http://localhost:5173
HOST=127.0.0.1
PORT=8000

# Optional query and streaming integrations
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
STREAM_INTERVAL=2.5
DATA_DIRECTORY=./data
AI_MODEL_PATH=../AIModel
AI_VEHICLE_MODEL_PATH=../AIModel/nh5_yolov8n_960.pt

# Optional initial administrator accounts; passwords are never logged
ADMIN1_USERNAME=user1
ADMIN1_EMAIL=user1@example.com
ADMIN1_PASSWORD=change_this_password
ADMIN2_USERNAME=user2
ADMIN2_EMAIL=user2@example.com
ADMIN2_PASSWORD=change_this_password
# Hugging Face Custom Inference Endpoint (Unified model serving Sushanthreddy03/vizioniq-ai-models)
HF_TOKEN=hf_your_huggingface_access_token_here
HF_MODEL_REPO=Sushanthreddy03/vizioniq-ai-models
HF_INFERENCE_URL=https://your-custom-endpoint.endpoints.huggingface.cloud
HF_INFERENCE_TIMEOUT=10.0
